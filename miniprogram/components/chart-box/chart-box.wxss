.chart-wrap { display: flex; flex-direction: column; align-items: center; padding: 16rpx 0; }
.chart-canvas { display: block; }
.legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx 24rpx; margin-top: 16rpx; padding: 0 16rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; font-size: 24rpx; }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex-shrink: 0; }
.label { color: #666; max-width: 120rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.val { color: #333; font-weight: bold; }

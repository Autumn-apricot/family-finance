.voice-input {
  padding: 24rpx 0;
  text-align: center;
}

.voice-input.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.voice-hint {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
  min-height: 40rpx;
}

.voice-hint .partial {
  display: block;
  color: #07c160;
  margin-top: 8rpx;
}

.voice-hint.processing {
  color: #1989fa;
}

.voice-hint.error {
  color: #e54d42;
}

.voice-hint.warn {
  color: #ad6800;
  background: #fff7e6;
  padding: 16rpx;
  border-radius: 8rpx;
  text-align: left;
  line-height: 1.5;
}

.pulse-dot {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  background: #e54d42;
  border-radius: 50%;
  margin-right: 8rpx;
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(1.2); }
}

.mic-btn {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.mic-btn.recording {
  background: #ffecec;
  box-shadow: 0 0 0 8rpx rgba(229, 77, 66, 0.2);
}

.mic-icon {
  font-size: 56rpx;
}

.mic-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.preview-card {
  margin-top: 32rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: left;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.preview-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.preview-row .label {
  width: 80rpx;
  color: #999;
}

.preview-row .value {
  flex: 1;
  color: #333;
}

.preview-row .amount {
  font-weight: bold;
  color: #e54d42;
  font-size: 36rpx;
}

.confidence {
  font-size: 22rpx;
  color: #07c160;
  margin-left: 12rpx;
}

.confidence.warn {
  color: #ff976a;
}

.btn-link,
.btn-outline {
  font-size: 26rpx;
  color: #07c160;
  padding: 16rpx;
}

.btn-outline {
  border: 1rpx solid #07c160;
  border-radius: 8rpx;
  text-align: center;
  margin-top: 16rpx;
}

.preview-actions {
  display: flex;
  justify-content: center;
}

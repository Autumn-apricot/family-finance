/* 个人信息卡片 */
.profile-card { position: relative; margin: 0 24rpx 20rpx; border-radius: 20rpx; overflow: hidden; }
.profile-bg { height: 140rpx; background: linear-gradient(135deg, #1677ff, #722ed1); }
.profile-content { background: #fff; padding: 0 28rpx 32rpx; text-align: center; }
.profile-avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: linear-gradient(135deg, #1677ff, #36cfc9); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 800; margin: -50rpx auto 14rpx; box-shadow: 0 4rpx 16rpx rgba(22,119,255,.3); }
.profile-name { font-size: 36rpx; font-weight: 800; color: #1a1a2e; margin-bottom: 6rpx; }
.profile-role { font-size: 24rpx; color: #999; }

/* 钱包 */
.wallet-card { background: linear-gradient(135deg, #434343, #1a1a2e); color: #fff; }
.wallet-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; font-size: 28rpx; font-weight: 600; color: rgba(255,255,255,.85); }
.wallet-total { font-size: 44rpx; font-weight: 800; }
.wallet-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16rpx; }
.wallet-item { background: rgba(255,255,255,.12); border-radius: 16rpx; padding: 22rpx 14rpx; text-align: center; transition: all .2s; }
.wallet-item:active { background: rgba(255,255,255,.22); transform: scale(.95); }
.wallet-item.neg { background: rgba(255,77,79,.25); }
.wallet-icon { font-size: 40rpx; display: block; margin-bottom: 10rpx; }
.wallet-label { font-size: 22rpx; color: rgba(255,255,255,.65); }
.wallet-balance { font-size: 28rpx; font-weight: 700; color: #fff; margin-top: 6rpx; }
.wallet-balance.neg { color: #ff7875; }
.wallet-tip { text-align: center; font-size: 22rpx; color: rgba(255,255,255,.4); margin-top: 18rpx; }

/* 设置 */
.settings-card { padding: 8rpx 0; }
.setting-row { display: flex; justify-content: space-between; align-items: center; padding: 26rpx 28rpx; border-bottom: 1rpx solid #f5f5f5; font-size: 30rpx; }
.setting-row:last-child { border-bottom: none; }
.setting-left { display: flex; align-items: center; gap: 18rpx; }
.setting-icon { font-size: 36rpx; }
.arrow { font-size: 40rpx; color: #ccc; font-weight: 300; }

/* 退出 */
.logout-wrap { padding: 40rpx 24rpx; }
.logout-btn { width: 100%; background: #fff; color: #ff4d4f; border: 1rpx solid #ffccc7; border-radius: 16rpx; font-size: 30rpx; padding: 22rpx; font-weight: 600; }

/* 预算弹窗 */
.budget-copy { text-align: center; color: #1677ff; font-size: 24rpx; padding: 12rpx; margin-bottom: 12rpx; background: #f0f5ff; border-radius: 10rpx; }
.budget-scroll { flex: 1; overflow-y: auto; max-height: 500rpx; }
.budget-item { display: flex; align-items: center; gap: 14rpx; padding: 20rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.budget-icon { font-size: 34rpx; flex-shrink: 0; }
.budget-name { flex: 1; font-size: 28rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.budget-input { width: 170rpx; border: 1rpx solid #e8e8e8; border-radius: 12rpx; padding: 14rpx 18rpx; font-size: 28rpx; text-align: right; background: #fafafa; }

.rec-item { display: flex; align-items: center; gap: 12rpx; padding: 18rpx 0; border-bottom: 1rpx solid #f0f2f5; }
.rec-del { color: #ff4d4f; font-size: 24rpx; flex-shrink: 0; }

.family-card { background: linear-gradient(135deg, #f093fb, #f5576c); color: #fff; }
.family-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; font-size: 28rpx; font-weight: 700; }
.family-code { font-size: 28rpx; font-weight: 700; background: rgba(255,255,255,.35); color: #fff; padding: 10rpx 22rpx; border-radius: 14rpx; letter-spacing: 2rpx; }
.family-members { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 16rpx; }
.family-member { background: rgba(255,255,255,.2); padding: 6rpx 16rpx; border-radius: 12rpx; font-size: 24rpx; }
.family-actions { text-align: right; }
.family-actions button { background: rgba(255,255,255,.2); color: #fff; border: none; font-size: 24rpx; padding: 10rpx 24rpx; border-radius: 12rpx; }
.family-empty { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; color: #666; }

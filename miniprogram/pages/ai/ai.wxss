.chat-box { height: calc(100vh - 210rpx); padding: 24rpx; box-sizing: border-box; }

/* 消息 */
.msg-wrap { display: flex; gap: 16rpx; margin-bottom: 28rpx; align-items: flex-start; }
.msg-wrap.user { flex-direction: row-reverse; }
.msg-avatar { width: 68rpx; height: 68rpx; border-radius: 50%; background: #f0f2f5; display: flex; align-items: center; justify-content: center; font-size: 36rpx; flex-shrink: 0; }
.msg-bubble { max-width: 70%; padding: 20rpx 26rpx; border-radius: 22rpx; line-height: 1.65; font-size: 28rpx; word-break: break-all; position: relative; }
.msg-bubble.user { background: linear-gradient(135deg, #1677ff, #4096ff); color: #fff; border-bottom-right-radius: 6rpx; }
.msg-bubble.ai { background: #fff; color: #333; border-bottom-left-radius: 6rpx; box-shadow: 0 2rpx 16rpx rgba(0,0,0,.05); }

.loading-hint { text-align: center; color: #bbb; padding: 80rpx; font-size: 26rpx; }

/* 历史对话触发器 */
.history-trigger { text-align: center; padding: 20rpx; color: #1677ff; font-size: 26rpx; }
.history-trigger:active { opacity: .6; }
.history-end { text-align: center; color: #ccc; font-size: 24rpx; padding: 20rpx; }

/* 输入栏 */
.input-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 18rpx 24rpx 30rpx; box-shadow: 0 -6rpx 24rpx rgba(0,0,0,.04); border-radius: 26rpx 26rpx 0 0; }
.input-row { display: flex; align-items: center; gap: 14rpx; }
.chat-input { flex: 1; background: #f5f7fa; padding: 20rpx 26rpx; border-radius: 28rpx; font-size: 28rpx; border: 2rpx solid transparent; transition: border-color .2s; }
.chat-input:focus { border-color: #1677ff; background: #fff; }
.send-btn { background: linear-gradient(135deg, #1677ff, #36cfc9); color: #fff; border: none; border-radius: 28rpx; padding: 20rpx 34rpx; font-size: 28rpx; font-weight: 700; box-shadow: 0 4rpx 14rpx rgba(22,119,255,.25); }
.send-btn:active { opacity: .85; transform: scale(.96); }
.send-btn::after { border: none; }
.input-chips { display: flex; gap: 16rpx; margin-top: 16rpx; }
.mini-chip { font-size: 24rpx; color: #1677ff; background: #f0f5ff; padding: 10rpx 22rpx; border-radius: 18rpx; font-weight: 500; transition: all .2s; }
.mini-chip:active { background: #1677ff; color: #fff; }

.login-page { min-height: 100vh; position: relative; display: flex; align-items: center; justify-content: center; }
.login-bg { position: fixed; inset: 0; background: linear-gradient(160deg, #1677ff 0%, #722ed1 50%, #eb2f96 100%); z-index: 0; }
.login-content { position: relative; z-index: 1; width: 100%; padding: 60rpx 48rpx; }

.logo { font-size: 100rpx; text-align: center; margin-bottom: 10rpx; }
.app-name { font-size: 48rpx; font-weight: 800; color: #fff; text-align: center; letter-spacing: 4rpx; }
.app-desc { font-size: 26rpx; color: rgba(255,255,255,.6); text-align: center; margin-bottom: 50rpx; }

.backend-warn { background: rgba(255,255,255,.15); color: #ffd591; font-size: 24rpx; padding: 20rpx 28rpx; border-radius: 14rpx; margin-bottom: 24rpx; line-height: 1.5; text-align: center; }

.login-card { background: #fff; border-radius: 24rpx; padding: 40rpx 32rpx; box-shadow: 0 16rpx 48rpx rgba(0,0,0,.15); }
.card-title { font-size: 34rpx; font-weight: 700; color: #1a1a2e; text-align: center; margin-bottom: 32rpx; }

.input-wrap { display: flex; align-items: center; background: #f5f7fa; border-radius: 16rpx; padding: 0 24rpx; margin-bottom: 20rpx; border: 2rpx solid transparent; transition: border-color .2s; }
.input-wrap:focus-within { border-color: #1677ff; background: #fff; }
.input-icon { font-size: 32rpx; margin-right: 14rpx; flex-shrink: 0; }
.input-wrap input { flex: 1; background: transparent; border: none; padding: 24rpx 0; font-size: 30rpx; }

.login-btn { width: 100%; background: linear-gradient(135deg, #1677ff, #722ed1); color: #fff; border: none; border-radius: 16rpx; padding: 26rpx; font-size: 32rpx; font-weight: 700; margin-top: 12rpx; box-shadow: 0 8rpx 24rpx rgba(22,119,255,.3); letter-spacing: 8rpx; }
.login-btn:active { opacity: .85; transform: scale(.98); }

.switch-link { text-align: center; color: #1677ff; font-size: 26rpx; margin-top: 24rpx; }

.login-footer { text-align: center; color: rgba(255,255,255,.4); font-size: 22rpx; margin-top: 40rpx; }

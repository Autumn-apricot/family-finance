.summary-row { display: flex; margin-bottom: 20rpx; }
.summary-item { flex: 1; text-align: center; }
.summary-item .label { font-size: 22rpx; color: rgba(255,255,255,.7); margin-bottom: 4rpx; }
.summary-item .val { font-size: 36rpx; font-weight: 800; }
.summary-item .lend { color: #ffd591; }
.summary-item .borrow { color: #91d5ff; }
.summary-item .net { color: #b7eb8f; }
.summary-item .over { color: #ffccc7; }

.filter-tabs { display: flex; margin-bottom: 24rpx; gap: 12rpx; }
.filter-tab { padding: 12rpx 32rpx; border-radius: 22rpx; background: #f0f2f5; font-size: 26rpx; color: #666; font-weight: 500; transition: all .2s; }
.filter-tab.active { background: #1677ff; color: #fff; }

.loan-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,.04); }
.loan-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.loan-name { font-size: 32rpx; font-weight: 700; }
.loan-amount { font-size: 34rpx; font-weight: 800; }
.loan-amount.lend { color: #fa8c16; }
.loan-amount.borrow { color: #1677ff; }
.loan-meta { font-size: 24rpx; color: #999; display: flex; gap: 16rpx; align-items: center; }
.tag { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 8rpx; color: #fff; font-weight: 600; }
.tag.pending { background: #fa8c16; }
.tag.partial { background: #1677ff; }
.tag.settled { background: #07c160; }
.tag.overdue { background: #ff4d4f; }
.loan-actions { display: flex; gap: 20rpx; margin-top: 16rpx; justify-content: flex-end; }
.loan-actions text { font-size: 26rpx; color: #1677ff; font-weight: 500; }

.fab { position: fixed; right: 44rpx; bottom: 140rpx; width: 108rpx; height: 108rpx; background: #1677ff; color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 52rpx; box-shadow: 0 8rpx 28rpx rgba(22,119,255,.35); z-index: 50; transition: transform .2s; }
.fab:active { transform: scale(.9); }

/* 标签 */
.tabs { display: flex; margin: 20rpx 24rpx; gap: 12rpx; }
.tab { flex: 1; text-align: center; padding: 22rpx 0; border-radius: 16rpx; font-size: 26rpx; font-weight: 600; color: #999; background: #fff; transition: all .2s; }
.tab.active { background: #1677ff; color: #fff; box-shadow: 0 4rpx 16rpx rgba(22,119,255,.25); }

/* KPI 卡片 */
.kpi-card { text-align: center; padding: 28rpx 24rpx; }
.kpi-date { font-size: 28rpx; color: #999; margin-bottom: 20rpx; }
.kpi-row { display: flex; align-items: baseline; justify-content: space-around; }
.kpi-item { display: flex; flex-direction: column; align-items: center; }
.kpi-num { font-size: 44rpx; font-weight: 800; white-space: nowrap; }
.kpi-label { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.kpi-item.out .kpi-num { color: #ff4d4f; }
.kpi-item.in .kpi-num { color: #07c160; }
.kpi-item.bal .kpi-num { color: #1677ff; }
.kpi-divider { width: 2rpx; height: 56rpx; background: #e0e0e0; border-radius: 1rpx; flex-shrink: 0; margin: 0 8rpx; }
.share-btn-wrap { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f2f5; }
.share-btn { background: #f0f5ff; color: #1677ff; border: none; border-radius: 14rpx; font-size: 26rpx; padding: 16rpx; }

/* 分类占比条 */
.bar-row { display: flex; align-items: center; gap: 12rpx; padding: 12rpx 0; font-size: 26rpx; }
.bar-wrap { flex: 1; height: 12rpx; background: #f0f2f5; border-radius: 6rpx; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 6rpx; transition: width .4s ease; }
.bar-val { font-size: 24rpx; color: #999; flex-shrink: 0; min-width: 100rpx; text-align: right; }

/* 成员 */
.member-row { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.member-name { font-weight: 700; font-size: 28rpx; }
.member-amounts { display: flex; gap: 24rpx; }
.member-out { color: #ff4d4f; font-size: 26rpx; font-weight: 600; }
.member-in { color: #07c160; font-size: 26rpx; font-weight: 600; }

/* 预算 */
.budget-list { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f2f5; }
.budget-row { display: flex; align-items: center; padding: 12rpx 0; font-size: 26rpx; gap: 8rpx; }
.budget-row.over { background: #fff2f0; margin: 0 -12rpx; padding: 14rpx 12rpx; border-radius: 10rpx; }
.budget-amounts { color: #999; font-size: 24rpx; flex: 1; text-align: right; }
.budget-cap { color: #1677ff; }
.over .budget-amounts { color: #ff4d4f; }
.over-tag { background: #ff4d4f; color: #fff; font-size: 20rpx; padding: 2rpx 12rpx; border-radius: 6rpx; font-weight: 600; }

/* 年度趋势 */
.trend-row { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 0; border-bottom: 1rpx solid #f5f5f5; }
.trend-month { font-size: 24rpx; color: #666; width: 90rpx; flex-shrink: 0; }
.trend-bar-wrap { flex: 1; height: 20rpx; background: #f0f2f5; border-radius: 4rpx; overflow: hidden; position: relative; }
.trend-bar-out { height: 8rpx; background: #ff4d4f; border-radius: 4rpx; position: absolute; top: 2rpx; left: 0; }
.trend-bar-in { height: 8rpx; background: #07c160; border-radius: 4rpx; position: absolute; bottom: 2rpx; left: 0; }
.trend-amounts { display: flex; gap: 10rpx; flex-shrink: 0; }
.trend-amounts text { font-size: 22rpx; font-weight: 600; }
.trend-row .arrow { font-size: 28rpx; color: #ccc; flex-shrink: 0; }
